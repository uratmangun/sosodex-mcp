# Copy from .env.local on the VPS: /home/ubuntu/apps/google-map-test/.env.local
# chmod 600 .env.local — never commit secrets.

# --- Required production overrides ---
BETTER_AUTH_URL=https://maps.uratmangun.ovh
NEXT_PUBLIC_GPT_APP_ORIGIN=https://maps.uratmangun.ovh
MCP_CHAT_URL=http://termux-stack:3004/mcp
MCP_INTERNAL_HOST=termux-stack
DATABASE_PATH=/data/google-map-test.sqlite
NODE_ENV=production

# PostHog (project 438316, US Cloud) — use /ingest reverse proxy from next.config.ts
NEXT_PUBLIC_POSTHOG_TOKEN=phc_your_project_token
NEXT_PUBLIC_POSTHOG_HOST=/ingest
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# --- From local .env.local (keep your values) ---
# GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# GCP_PROJECT_ID=
# BETTER_AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AI_PROVIDER_BASE_URL=
# AI_PROVIDER_API_KEY=
# MAPS_QUOTA_GUARD=true

# Google Cloud Console:
# - Maps API key HTTP referrers: https://maps.uratmangun.ovh/*
# - OAuth redirect: https://maps.uratmangun.ovh/api/auth/callback/google
# - APIs: places.googleapis.com, maps-embed-backend.googleapis.com
#
# VPS quota guard + /maps-usage: service account key (see deploy/setup-gcp-monitoring-sa.sh)
# Quadlet mounts: gcp/monitoring-sa.json → GOOGLE_APPLICATION_CREDENTIALS=/run/gcp/monitoring-sa.json
