# SoSoValue OpenAPI — https://openapi.sosovalue.com
# Docs: https://sosovalue-1.gitbook.io/sosovalue-api-doc
SOSOVALUE_API_KEY=
# SOSOVALUE_API_BASE_URL=https://openapi.sosovalue.com/openapi/v1

# Public origin for MCP App / ChatGPT widget CSP (defaults to http://localhost:3000)
# NEXT_PUBLIC_GPT_APP_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_MCP_APP_ORIGIN=http://localhost:3000

# In-app chat MCP client — same app, loopback in dev/local prod
# MCP_CHAT_URL=http://127.0.0.1:3000/mcp
# VPS Podman only: MCP_INTERNAL_HOST=termux-stack

# PostHog analytics (optional)
# NEXT_PUBLIC_POSTHOG_TOKEN=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=/ingest
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Better Auth — required for guest sign-in / Google OAuth
# Keep http://localhost:3000 for local production (`pnpm build` then `pnpm start`)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# Default assistant LLM (server-side only)
# AI_PROVIDER_BASE_URL=https://opencode.ai/zen/v1
# AI_PROVIDER_API_KEY=
# AI_PROVIDER_DEFAULT_MODEL=minimax-m3-free
