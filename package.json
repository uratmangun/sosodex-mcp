    "@ai-sdk/openai-compatible": "^2.0.41",
    "@ai-sdk/react": "^3.0.160",
    "@base-ui/react": "^1.3.0",
    "@modelcontextprotocol/ext-apps": "^1.7.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
